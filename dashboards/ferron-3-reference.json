    {
      "type": "timeseries",
      "title": "Traffic rate by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "$data_source"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "never",
            "axisCenteredZero": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "rps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$data_source"
          },
          "expr": "sum by (http_response_status_code) (rate(ferron_http_server_request_count_total{job=\"$job\",instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
